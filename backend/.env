# Backend Environment Variables for EduMate

# Database
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/edumate?sslmode=disable

# Security
SECRET_KEY=super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS S3 Settings
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=edumate-files